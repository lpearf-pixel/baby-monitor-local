<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.babymonitor.voice-asr-operator</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/.venv-alpha/bin/python</string>
    <string>-m</string>
    <string>tools.voice_asr_capture_macos</string>
    <string>login-job</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/runtime/status/voice-asr-capture.txt</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/runtime/status/voice-asr-operator.err</string>
</dict>
</plist>
