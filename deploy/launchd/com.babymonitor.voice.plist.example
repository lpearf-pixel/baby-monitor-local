<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.babymonitor.voice</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/.venv-alpha/bin/python</string>
    <string>__PROJECT_ROOT__/tools/run_voice_worker.py</string>
    <string>--settings</string>
    <string>__PROJECT_ROOT__/runtime/settings.yaml</string>
    <string>--voice-models</string>
    <string>__PROJECT_ROOT__/runtime/config/voice-care-models.json</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/runtime/logs/voice.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/runtime/logs/voice.log</string>
</dict>
</plist>
