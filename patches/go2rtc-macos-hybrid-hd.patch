+func TestSpeakerLifecycleStopWaitsForInflightWrite(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	conn.writeEntered = make(chan struct{}, 1)
+	conn.writeRelease = make(chan struct{})
+	client := newLifecycleReviewClient(conn)
+	t.Cleanup(func() { _ = client.Close() })
+	session, err := client.StartSpeaker()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	writeDone := make(chan error, 1)
+	go func() { writeDone <- session.WriteAudio(codecPCMA, make([]byte, 320)) }()
+	select {
+	case <-conn.writeEntered:
+	case <-time.After(time.Second):
+		t.Fatal("audio write did not enter transport")
+	}
+	stopDone := make(chan error, 1)
+	go func() { stopDone <- session.Stop() }()
+	time.Sleep(10 * time.Millisecond)
+	_, _, stopsBeforeRelease, _, _ := conn.snapshot()
+	if stopsBeforeRelease != 0 {
+		t.Fatal("speaker stop overtook in-flight audio write")
+	}
+	close(conn.writeRelease)
+	if err := <-writeDone; err != nil {
+		t.Fatal(err)
+	}
+	if err := <-stopDone; err != nil {
+		t.Fatal(err)
+	}
+	_, _, stops, _, writes := conn.snapshot()
