+func TestSpeakerLifecycleProducerSettlementRejectsQueuedWriteBeforeSenderDrain(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	conn.writeEntered = make(chan struct{}, 1)
+	conn.writeRelease = make(chan struct{})
+	client := newLifecycleReviewClient(conn)
+	t.Cleanup(func() { _ = client.Close() })
+	producer := &Producer{Connection: core.Connection{Transport: conn}, client: client}
+	codec := &core.Codec{Name: core.CodecPCMA, ClockRate: 8000}
+	media := &core.Media{Kind: core.KindAudio, Direction: core.DirectionSendonly, Codecs: []*core.Codec{codec}}
+	track := core.NewReceiver(media, codec)
+	if err := producer.AddTrack(media, codec, track); err != nil {
+		t.Fatal(err)
+	}
+
+	track.WriteRTP(&rtp.Packet{Payload: make([]byte, 320)})
+	select {
+	case <-conn.writeEntered:
+	case <-time.After(time.Second):
+		t.Fatal("first queued write did not enter transport")
+	}
+	track.WriteRTP(&rtp.Packet{Payload: make([]byte, 320)})
+	settled := make(chan error, 1)
+	go func() { settled <- producer.SettleBackchannel() }()
+	deadline := time.Now().Add(time.Second)
+	for client.SpeakerLifecycleStatus().SpeakerState != "stopping" && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if client.SpeakerLifecycleStatus().SpeakerState != "stopping" {
+		close(conn.writeRelease)
+		<-settled
+		t.Fatal("settlement did not disable writes before sender drain")
+	}
+	close(conn.writeRelease)
+	if err := <-settled; err != nil {
+		t.Fatal(err)
+	}
+	_, _, _, _, writes := conn.snapshot()
+	if writes != 1 {
+		t.Fatalf("transport writes = %d, want only the in-flight write", writes)
+	}
+}
