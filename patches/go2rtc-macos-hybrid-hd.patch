index 00000000..79ec1578
--- /dev/null
+++ b/internal/streams/play_lifecycle_review_test.go
@@ -0,0 +1,305 @@
+package streams
+
+import (
+	"errors"
+	"io"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+)
+
+type lifecycleSource struct {
+	media      *core.Media
+	track      *core.Receiver
+	startBlock chan struct{}
+	stopOnce   sync.Once
+	stopped    chan struct{}
+	startErr   error
+}
+
+func newLifecycleSource(block bool) *lifecycleSource {
+	codec := &core.Codec{Name: core.CodecPCMA, ClockRate: 8000}
+	media := &core.Media{Kind: core.KindAudio, Direction: core.DirectionRecvonly, Codecs: []*core.Codec{codec}}
+	s := &lifecycleSource{media: media, track: core.NewReceiver(media, codec), stopped: make(chan struct{})}
+	if block {
+		s.startBlock = make(chan struct{})
+	}
+	return s
+}
+
+func (s *lifecycleSource) GetMedias() []*core.Media { return []*core.Media{s.media} }
+func (s *lifecycleSource) GetTrack(*core.Media, *core.Codec) (*core.Receiver, error) {
+	return s.track, nil
+}
+func (s *lifecycleSource) Start() error {
+	if s.startBlock != nil {
+		<-s.startBlock
+	}
+	return s.startErr
+}
+func (s *lifecycleSource) Stop() error {
+	s.stopOnce.Do(func() {
+		if s.startBlock != nil {
+			close(s.startBlock)
+		}
+		close(s.stopped)
+	})
+	return nil
+}
+
+type lifecycleBackchannel struct {
+	media       *core.Media
+	settleErr   error
+	settleCount int
+	settled     chan struct{}
+	settleBlock chan struct{}
+	mu          sync.Mutex
+}
+
+func newLifecycleBackchannel() *lifecycleBackchannel {
+	codec := &core.Codec{Name: core.CodecPCMA, ClockRate: 8000}
+	return &lifecycleBackchannel{
+		media:   &core.Media{Kind: core.KindAudio, Direction: core.DirectionSendonly, Codecs: []*core.Codec{codec}},
+		settled: make(chan struct{}),
+	}
+}
+
+func (c *lifecycleBackchannel) GetMedias() []*core.Media { return []*core.Media{c.media} }
+func (c *lifecycleBackchannel) GetTrack(*core.Media, *core.Codec) (*core.Receiver, error) {
+	return nil, core.ErrCantGetTrack
+}
+func (c *lifecycleBackchannel) AddTrack(*core.Media, *core.Codec, *core.Receiver) error {
+	return nil
+}
+func (c *lifecycleBackchannel) Start() error { return nil }
+func (c *lifecycleBackchannel) Stop() error  { return nil }
+func (c *lifecycleBackchannel) SettleBackchannel() error {
+	c.mu.Lock()
+	c.settleCount++
+	if c.settleCount == 1 {
+		close(c.settled)
+	}
+	err := c.settleErr
+	block := c.settleBlock
+	c.mu.Unlock()
+	if block != nil {
+		<-block
+	}
+	return err
+}
+
+func TestPlayEmptySettlesBackchannelBeforeSuccess(t *testing.T) {
+	source := newLifecycleSource(true)
+	backchannel := newLifecycleBackchannel()
+	stream := &Stream{producers: []*Producer{{conn: backchannel, state: stateExternal, url: "synthetic:xiaomi"}}}
+
+	if err := stream.Play(source); err != nil {
+		t.Fatal(err)
+	}
+	if err := stream.Play(""); err != nil {
+		t.Fatal(err)
+	}
+	if backchannel.settleCount != 1 {
+		t.Fatalf("backchannel settlement count = %d, want 1 before success", backchannel.settleCount)
+	}
+}
+
+func TestPlayEmptyPropagatesBackchannelStopFailure(t *testing.T) {
+	source := newLifecycleSource(true)
+	backchannel := newLifecycleBackchannel()
+	backchannel.settleErr = errors.New("synthetic speaker stop failure")
+	stream := &Stream{producers: []*Producer{{conn: backchannel, state: stateExternal, url: "synthetic:xiaomi"}}}
+
+	if err := stream.Play(source); err != nil {
+		t.Fatal(err)
+	}
+	if err := stream.Play(""); !errors.Is(err, errBackchannelSettlement) {
+		t.Fatalf("Play empty error = %v, want backchannel stop failure", err)
+	}
+}
+
+func TestNaturalSourceEndSettlesBackchannelOnce(t *testing.T) {
+	source := newLifecycleSource(false)
+	backchannel := newLifecycleBackchannel()
+	stream := &Stream{producers: []*Producer{{conn: backchannel, state: stateExternal, url: "synthetic:xiaomi"}}}
+
+	if err := stream.Play(source); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-backchannel.settled:
+	case <-time.After(time.Second):
+		t.Fatal("natural source end did not settle backchannel")
+	}
+	if backchannel.settleCount != 1 {
+		t.Fatalf("backchannel settlement count = %d, want 1", backchannel.settleCount)
+	}
+}
+
+func TestNaturalSourceEOFSucceedsForFiniteMedia(t *testing.T) {
+	source := newLifecycleSource(false)
+	source.startErr = io.EOF
+	backchannel := newLifecycleBackchannel()
+	stream := &Stream{producers: []*Producer{{conn: backchannel, state: stateExternal, url: "synthetic:xiaomi"}}}
+
+	if err := stream.Play(source); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-backchannel.settled:
+	case <-time.After(time.Second):
+		t.Fatal("finite media EOF did not settle backchannel")
+	}
+	if err := stream.Play(""); err != nil {
+		t.Fatalf("finite media EOF settlement error = %v, want success", err)
+	}
+}
+
+func TestCancelAndNaturalEndDoNotDoubleStop(t *testing.T) {
+	source := newLifecycleSource(true)
+	backchannel := newLifecycleBackchannel()
+	stream := &Stream{producers: []*Producer{{conn: backchannel, state: stateExternal, url: "synthetic:xiaomi"}}}
+
+	if err := stream.Play(source); err != nil {
+		t.Fatal(err)
+	}
+	if err := stream.Play(""); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-source.stopped:
+	case <-time.After(time.Second):
+		t.Fatal("explicit stop did not stop internal source")
+	}
+	select {
+	case <-backchannel.settled:
+	case <-time.After(time.Second):
+		t.Fatal("cancel and natural end never settled backchannel")
+	}
+	if backchannel.settleCount != 1 {
+		t.Fatalf("backchannel settlement count = %d, want exactly 1", backchannel.settleCount)
+	}
+}
+
+func TestNaturalSourceFailurePropagatesOnEmptyStop(t *testing.T) {
+	source := newLifecycleSource(false)
+	source.startErr = errors.New("synthetic source failure")
+	backchannel := newLifecycleBackchannel()
+	stream := &Stream{producers: []*Producer{{conn: backchannel, state: stateExternal, url: "synthetic:xiaomi"}}}
+
+	if err := stream.Play(source); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-backchannel.settled:
+	case <-time.After(time.Second):
+		t.Fatal("source failure did not settle backchannel")
+	}
+	select {
+	case <-source.stopped:
+	case <-time.After(time.Second):
+		t.Fatal("failed source was not stopped")
+	}
+	if err := stream.Play(""); !errors.Is(err, errBackchannelSettlement) {
+		t.Fatalf("empty stop error = %v, want fixed settlement failure", err)
+	}
+}
+
+func TestPlayEmptyTimesOutBlockedSettlementAndKeepsGenerationBusy(t *testing.T) {
+	source := newLifecycleSource(true)
+	backchannel := newLifecycleBackchannel()
+	backchannel.settleBlock = make(chan struct{})
+	stream := &Stream{producers: []*Producer{{conn: backchannel, state: stateExternal, url: "synthetic:xiaomi"}}}
+	if err := stream.Play(source); err != nil {
+		t.Fatal(err)
+	}
+
+	result := make(chan error, 1)
+	go func() { result <- stream.Play("") }()
+	select {
+	case err := <-result:
+		if !errors.Is(err, errBackchannelSettlement) {
+			t.Fatalf("blocked settlement error = %v, want fixed failure", err)
+		}
+	case <-time.After(2 * time.Second):
+		close(backchannel.settleBlock)
+		<-result
+		t.Fatal("blocked settlement exceeded fixed timeout")
+	}
+	if err := stream.Play(newLifecycleSource(true)); !errors.Is(err, errBackchannelBusy) {
+		t.Fatalf("post-timeout overlap error = %v, want busy", err)
+	}
+	close(backchannel.settleBlock)
+}
+
+func TestOverlappingPlayIsRejectedWithoutStartingSecondSource(t *testing.T) {
+	first := newLifecycleSource(true)
+	second := newLifecycleSource(true)
+	backchannel := newLifecycleBackchannel()
+	stream := &Stream{producers: []*Producer{{conn: backchannel, state: stateExternal, url: "synthetic:xiaomi"}}}
+
+	if err := stream.Play(first); err != nil {
+		t.Fatal(err)
+	}
+	if err := stream.Play(second); !errors.Is(err, errBackchannelBusy) {
+		t.Fatalf("overlap error = %v, want fixed busy", err)
+	}
+	select {
+	case <-second.stopped:
+		t.Fatal("rejected second source was stopped despite never starting")
+	default:
+	}
+	if err := stream.Play(""); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPlaybackSettlementDoesNotReplaceProducer(t *testing.T) {
+	backchannel := newLifecycleBackchannel()
+	external := &Producer{conn: backchannel, state: stateExternal, url: "synthetic:xiaomi"}
+	stream := &Stream{producers: []*Producer{external}}
+
+	for i := 0; i < 6; i++ {
+		if err := stream.Play(newLifecycleSource(true)); err != nil {
+			t.Fatalf("cycle %d play: %v", i, err)
+		}
+		if err := stream.Play(""); err != nil {
+			t.Fatalf("cycle %d settle: %v", i, err)
+		}
+		if len(stream.producers) != 1 || stream.producers[0] != external {
+			t.Fatalf("cycle %d replaced shared external producer", i)
+		}
+	}
+	if backchannel.settleCount != 6 {
+		t.Fatalf("settlement count = %d, want 6", backchannel.settleCount)
+	}
+}
+
+func TestReconnectBackoffDoesNotDuplicateWorkers(t *testing.T) {
+	const scheme = "lifecycle-stale-reconnect"
+	calls := 0
+	HandleFunc(scheme, func(string) (core.Producer, error) {
+		calls++
+		return nil, errors.New("synthetic reconnect should not run")
+	})
+	producer := &Producer{
+		url:      scheme + ":source",
+		state:    stateStart,
+		workerID: 2,
+	}
+
+	var group sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			producer.reconnect(1, 1)
+		}()
+	}
+	group.Wait()
+	if calls != 0 || producer.workerID != 2 {
+		t.Fatalf("stale reconnect calls/worker = %d/%d, want 0/2", calls, producer.workerID)
+	}
+}
