+func TestWritePacketCopiesPayload(t *testing.T) {
+	reader, writer := net.Pipe()
+	defer reader.Close()
+	defer writer.Close()
+
+	conn := &Conn{Conn: writer}
+	header := bytes.Repeat([]byte{0xA5}, hdrSize)
+	payload := []byte{0x10, 0x20, 0x30, 0x40, 0x50}
+	written := make(chan error, 1)
+	go func() {
+		written <- conn.WritePacket(header, payload)
+	}()
+
+	got := make([]byte, 12+len(header)+len(payload))
+	if _, err := io.ReadFull(reader, got); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-written; err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got[12:12+hdrSize], header) {
+		t.Fatal("header mismatch")
+	}
+	if !bytes.Equal(got[12+hdrSize:], payload) {
+		t.Fatal("payload mismatch")
+	}
+}
