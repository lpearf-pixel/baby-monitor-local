+			t.Fatal("empty payload was accepted")
+		}
+	case <-time.After(100 * time.Millisecond):
+		_ = emptyReader.Close()
+		_ = emptyWriter.Close()
+		<-emptyResult
+		t.Fatal("empty payload attempted a transport write")
+	}
+	if emptyConn.seqCh3 != 0 {
+		t.Fatal("empty payload consumed channel-3 sequence")
+	}
+	_ = emptyReader.Close()
+	_ = emptyWriter.Close()
+
+	mediaReader, mediaWriter := net.Pipe()
+	defer mediaReader.Close()
+	defer mediaWriter.Close()
+	conn := &Conn{Conn: mediaWriter}
+	if conn.seqCh3 != 0 {
+		t.Fatal("empty payload was accepted")
+	}
+
+	payloads := [][]byte{{0x11, 0x12}, {0x21, 0x22, 0x23}}
+	written := make(chan error, len(payloads))
+	for index, payload := range payloads {
+		go func(value []byte) { written <- conn.WritePacket(header, value) }(payload)
+		frame := make([]byte, 12+hdrSize+len(payload))
+		if _, err := io.ReadFull(mediaReader, frame); err != nil {
+			t.Fatal(err)
+		}
+		if frame[5] != 3 {
+			t.Fatalf("channel = %d, want 3", frame[5])
+		}
+		if sequence := binary.BigEndian.Uint16(frame[6:]); sequence != uint16(index) {
+			t.Fatalf("sequence = %d, want %d", sequence, index)
+		}
+		if !bytes.Equal(frame[12:12+hdrSize], header) {
+			t.Fatal("header was not written at the header offset")
+		}
+		if !bytes.Equal(frame[12+hdrSize:], payload) {
+			t.Fatal("payload was not written at the payload offset")
+		}
+		if err := <-written; err != nil {
+			t.Fatal(err)
+		}
+	}
+}
diff --git a/pkg/xiaomi/miss/cs2/lifecycle_review_test.go b/pkg/xiaomi/miss/cs2/lifecycle_review_test.go
new file mode 100644
index 00000000..c75be2cc
--- /dev/null
+++ b/pkg/xiaomi/miss/cs2/lifecycle_review_test.go
@@ -0,0 +1,135 @@
+package cs2
+
+import (
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+type scriptedConn struct {
+	reads chan []byte
+}
+
+func (c *scriptedConn) Read(dst []byte) (int, error) {
+	frame, ok := <-c.reads
+	if !ok {
+		return 0, io.EOF
+	}
+	return copy(dst, frame), nil
+}
+
+func (c *scriptedConn) Write(src []byte) (int, error) { return len(src), nil }
+func (c *scriptedConn) Close() error                  { return nil }
+func (c *scriptedConn) LocalAddr() net.Addr           { return nil }
+func (c *scriptedConn) RemoteAddr() net.Addr          { return nil }
+func (c *scriptedConn) SetDeadline(time.Time) error   { return nil }
+func (c *scriptedConn) SetReadDeadline(time.Time) error {
+	return nil
+}
+func (c *scriptedConn) SetWriteDeadline(time.Time) error {
+	return nil
+}
+
+func reviewFrame(channel byte, payload []byte) []byte {
+	frame := make([]byte, 12+len(payload))
+	frame[0] = magic
+	frame[1] = msgDrw
+	frame[4] = magicDrw
+	frame[5] = channel
+	binary.BigEndian.PutUint32(frame[8:], uint32(len(payload)))
+	copy(frame[12:], payload)
+	return frame
+}
+
+func TestRepeatedSpeakerResponsesDoNotCloseMediaChannel(t *testing.T) {
+	transport := &scriptedConn{reads: make(chan []byte, 12)}
+	conn := &Conn{
+		Conn:  transport,
+		isTCP: true,
+		channels: [4]*dataChannel{
+			newCommandDataChannel(10), nil, newDataChannel(250, 100), nil,
+		},
+	}
+
+	// 0x107 is cmdSpeakerStartRes. Eleven unanswered responses exceed the
+	// current command-channel capacity of ten.
+	for i := 0; i < 11; i++ {
+		response := make([]byte, 8)
+		binary.LittleEndian.PutUint32(response, 0x107)
+		transport.reads <- reviewFrame(0, response)
+	}
+	wantHeader := make([]byte, hdrSize)
+	wantPayload := []byte{0x7a}
+	transport.reads <- reviewFrame(2, append(wantHeader, wantPayload...))
+
+	go conn.worker()
+
+	done := make(chan error, 1)
+	go func() {
+		_, payload, err := conn.ReadPacket()
+		if err == nil && len(payload) == 1 && payload[0] == wantPayload[0] {
+			done <- nil
+			return
+		}
+		if err == nil {
+			err = io.ErrUnexpectedEOF
+		}
+		done <- err
+	}()
+
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatalf("speaker responses closed the shared media channel: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("media packet did not settle after speaker responses")
+	}
+}
+
+func TestCommandChannelOverflowDropsCompleteFrame(t *testing.T) {
+	channel := newCommandDataChannel(1)
+	frame := make([]byte, 12)
+	binary.BigEndian.PutUint32(frame, 8)
+	for i := 0; i < 100; i++ {
+		_ = channel.Push(frame)
+	}
+	if len(channel.waitData) != 0 || channel.waitSize != 0 {
+		t.Fatalf("overflow retained wait bytes/size = %d/%d, want 0/0", len(channel.waitData), channel.waitSize)
+	}
+}
+
+func TestCommandChannelRejectsOversizedFrameWithoutRetainingBytes(t *testing.T) {
+	channel := newCommandDataChannel(1)
+	frame := make([]byte, 1200)
+	binary.BigEndian.PutUint32(frame, maxCommandFrameSize+1)
+	if err := channel.Push(frame); !errors.Is(err, errFrameTooLarge) {
+		t.Fatalf("oversized frame error = %v, want fixed rejection", err)
+	}
+	if len(channel.waitData) != 0 || channel.waitSize != 0 {
+		t.Fatalf("oversized frame retained wait bytes/size = %d/%d, want 0/0", len(channel.waitData), channel.waitSize)
+	}
+}
+
+func TestCommandChannelPreservesIngressTimeAcrossDelayedRead(t *testing.T) {
+	channel := newCommandDataChannel(1)
+	conn := &Conn{channels: [4]*dataChannel{channel}}
+	frame := append(make([]byte, 4), make([]byte, 4)...)
+	binary.BigEndian.PutUint32(frame, 4)
+	binary.LittleEndian.PutUint32(frame[4:], 0x107)
+	before := time.Now()
+	if err := channel.Push(frame); err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(10 * time.Millisecond)
+	_, _, receivedAt, err := conn.ReadCommandReceived()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if receivedAt.Before(before) || !receivedAt.Before(time.Now().Add(-5*time.Millisecond)) {
+		t.Fatalf("receivedAt = %v, want ingress time before delayed read", receivedAt)
+	}
+}
diff --git a/pkg/xiaomi/miss/lifecycle_review_test.go b/pkg/xiaomi/miss/lifecycle_review_test.go
new file mode 100644
index 00000000..87ab6bb4
--- /dev/null
+++ b/pkg/xiaomi/miss/lifecycle_review_test.go
@@ -0,0 +1,809 @@
+package miss
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/AlexxIT/go2rtc/pkg/core"
+	"github.com/AlexxIT/go2rtc/pkg/xiaomi/crypto"
+	"github.com/pion/rtp"
+)
+
+type lifecycleReviewConn struct {
+	mu               sync.Mutex
+	key              []byte
+	responses        chan lifecycleReviewResponse
+	closeOnce        sync.Once
+	startRequests    int
+	startResponses   int
+	stopCommands     int
+	pendingResponses int
+	packetWrites     int
+	writePacketErr   error
+	stopCommandErr   error
+	responseCommand  uint32
+	responseOuter    uint32
+	responseCopies   int
+	manualResponses  bool
+	syncResponse     bool
+	responseObserved chan struct{}
+	readEntered      chan struct{}
+	readReturn       chan struct{}
+	writeEntered     chan struct{}
+	writeRelease     chan struct{}
+	stopEntered      chan struct{}
+	stopRelease      chan struct{}
+}
+
+type lifecycleReviewResponse struct {
+	command    uint32
+	data       []byte
+	receivedAt time.Time
+}
+
+func newLifecycleReviewConn() *lifecycleReviewConn {
+	return &lifecycleReviewConn{responses: make(chan lifecycleReviewResponse, 32)}
+}
+
+func (c *lifecycleReviewConn) Protocol() string            { return "synthetic" }
+func (c *lifecycleReviewConn) Version() string             { return "synthetic" }
+func (c *lifecycleReviewConn) RemoteAddr() net.Addr        { return nil }
+func (c *lifecycleReviewConn) SetDeadline(time.Time) error { return nil }
+func (c *lifecycleReviewConn) Close() error {
+	c.closeOnce.Do(func() { close(c.responses) })
+	return nil
+}
+func (c *lifecycleReviewConn) ReadPacket() ([]byte, []byte, error) {
+	return nil, nil, errors.New("synthetic packet input unavailable")
+}
+
+func (c *lifecycleReviewConn) WriteCommand(outer uint32, encrypted []byte) error {
+	if outer != cmdEncoded {
+		return nil
+	}
+	plain, err := crypto.Decode(encrypted, c.key)
+	if err != nil {
+		return err
+	}
+	inner := binary.BigEndian.Uint32(plain)
+	c.mu.Lock()
+	var responses []lifecycleReviewResponse
+	var commandErr error
+	switch inner {
+	case cmdSpeakerStartReq:
+		c.startRequests++
+		if c.manualResponses {
+			c.mu.Unlock()
+			return nil
+		}
+		command := c.responseCommand
+		if command == 0 {
+			command = cmdSpeakerStartRes
+		}
+		copies := c.responseCopies
+		if copies == 0 {
+			copies = 1
+		}
+		for i := 0; i < copies; i++ {
+			c.pendingResponses++
+			plain := binary.BigEndian.AppendUint32(nil, command)
+			encrypted, encodeErr := crypto.Encode(plain, c.key)
+			if encodeErr != nil {
+				return encodeErr
+			}
+			outer := c.responseOuter
+			if outer == 0 {
+				outer = cmdEncoded
+			}
+			responses = append(responses, lifecycleReviewResponse{
+				command: outer, data: encrypted,
+			})
+		}
+	case cmdSpeakerStop:
+		c.stopCommands++
+		commandErr = c.stopCommandErr
+		entered := c.stopEntered
+		release := c.stopRelease
+		c.mu.Unlock()
+		if entered != nil {
+			select {
+			case entered <- struct{}{}:
+			default:
+			}
+		}
+		if release != nil {
+			<-release
+		}
+		c.mu.Lock()
+	}
+	synchronous := c.syncResponse
+	observed := c.responseObserved
+	c.mu.Unlock()
+	for _, response := range responses {
+		response := response
+		if synchronous {
+			response.receivedAt = time.Now()
+			c.responses <- response
+			if observed != nil {
+				<-observed
+			}
+		} else {
+			go func() {
+				time.Sleep(time.Millisecond)
+				response.receivedAt = time.Now()
+				c.responses <- response
+			}()
+		}
+	}
+	return commandErr
+}
+
+func (c *lifecycleReviewConn) ReadCommand() (uint32, []byte, error) {
+	command, data, _, err := c.ReadCommandReceived()
+	return command, data, err
+}
+
+func (c *lifecycleReviewConn) ReadCommandReceived() (uint32, []byte, time.Time, error) {
+	response, ok := <-c.responses
+	if !ok {
+		return 0, nil, time.Time{}, errors.New("synthetic connection closed")
+	}
+	c.mu.Lock()
+	c.pendingResponses--
+	c.startResponses++
+	observed := c.responseObserved
+	c.mu.Unlock()
+	if observed != nil {
+		select {
+		case observed <- struct{}{}:
+		default:
+		}
+	}
+	if c.readEntered != nil {
+		select {
+		case c.readEntered <- struct{}{}:
+		default:
+		}
+	}
+	if c.readReturn != nil {
+		<-c.readReturn
+	}
+	if response.receivedAt.IsZero() {
+		response.receivedAt = time.Now()
+	}
+	return response.command, response.data, response.receivedAt, nil
+}
+
+func (c *lifecycleReviewConn) enqueueSpeakerStartResponse() {
+	plain := binary.BigEndian.AppendUint32(nil, cmdSpeakerStartRes)
+	encrypted, err := crypto.Encode(plain, c.key)
+	if err != nil {
+		panic(err)
+	}
+	c.mu.Lock()
+	c.pendingResponses++
+	c.mu.Unlock()
+	c.responses <- lifecycleReviewResponse{
+		command: cmdEncoded, data: encrypted, receivedAt: time.Now(),
+	}
+}
+
+func (c *lifecycleReviewConn) WritePacket([]byte, []byte) error {
+	c.mu.Lock()
+	c.packetWrites++
+	err := c.writePacketErr
+	entered := c.writeEntered
+	release := c.writeRelease
+	c.mu.Unlock()
+	if entered != nil {
+		select {
+		case entered <- struct{}{}:
+		default:
+		}
+	}
+	if release != nil {
+		<-release
+	}
+	return err
+}
+
+func (c *lifecycleReviewConn) snapshot() (starts, responses, stops, pending, writes int) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.startRequests, c.startResponses, c.stopCommands, c.pendingResponses, c.packetWrites
+}
+
+func newLifecycleReviewClient(conn *lifecycleReviewConn) *Client {
+	key := make([]byte, 32)
+	conn.key = key
+	client := newClient(conn, key, "")
+	client.sleep = func(time.Duration) {}
+	client.startCommandDispatcher()
+	return client
+}
+
+func TestSpeakerLifecycleRejectsResponseBeforeTransportAck(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	conn.syncResponse = true
+	conn.responseObserved = make(chan struct{}, 1)
+	client := newLifecycleReviewClient(conn)
+	client.sleep = time.Sleep
+	t.Cleanup(func() { _ = client.Close() })
+
+	if _, err := client.StartSpeaker(); !errors.Is(err, errSpeakerCommandResponse) {
+		t.Fatalf("start error = %v, want pre-ACK response failure", err)
+	}
+}
+
+func TestSpeakerLifecycleRejectsQueuedPreAckResponseAfterAck(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	conn.syncResponse = true
+	conn.responseObserved = make(chan struct{}, 1)
+	conn.readEntered = make(chan struct{}, 1)
+	conn.readReturn = make(chan struct{})
+	client := newLifecycleReviewClient(conn)
+	t.Cleanup(func() { _ = client.Close() })
+
+	result := make(chan error, 1)
+	go func() {
+		_, err := client.StartSpeaker()
+		result <- err
+	}()
+	select {
+	case <-conn.readEntered:
+	case <-time.After(time.Second):
+		t.Fatal("response did not enter dispatcher")
+	}
+	deadline := time.Now().Add(time.Second)
+	for {
+		client.speakerMu.Lock()
+		armed := client.speakerArmed
+		client.speakerMu.Unlock()
+		if armed || time.Now().After(deadline) {
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	close(conn.readReturn)
+	if err := <-result; !errors.Is(err, errSpeakerCommandResponse) {
+		t.Fatalf("start error = %v, want queued pre-ACK response failure", err)
+	}
+}
+
+func TestSpeakerLifecycleRejectsPreviousResponseDuringQuiescence(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	client := newLifecycleReviewClient(conn)
+	client.sleep = time.Sleep
+	t.Cleanup(func() { _ = client.Close() })
+	first, err := client.StartSpeaker()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := first.Stop(); err != nil {
+		t.Fatal(err)
+	}
+	conn.manualResponses = true
+	second := make(chan error, 1)
+	go func() {
+		_, err := client.StartSpeaker()
+		second <- err
+	}()
+	time.Sleep(50 * time.Millisecond)
+	starts, _, _, _, _ := conn.snapshot()
+	if starts != 1 {
+		conn.enqueueSpeakerStartResponse()
+		<-second
+		t.Fatalf("new request count = %d during response quiescence, want 1", starts)
+	}
+	conn.enqueueSpeakerStartResponse()
+	if err := <-second; !errors.Is(err, errSpeakerCommandResponse) {
+		t.Fatalf("second start error = %v, want delayed-response failure", err)
+	}
+}
+
+func waitForCommandFailure(t *testing.T, client *Client) error {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		client.speakerMu.Lock()
+		err := client.commandFailure
+		client.speakerMu.Unlock()
+		if err != nil {
+			return err
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("command failure was not published")
+	return nil
+}
+
+func TestSpeakerLifecycleStartsAndStopsExactlyOnce(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	client := newLifecycleReviewClient(conn)
+	t.Cleanup(func() { _ = client.Close() })
+
+	session, err := client.StartSpeaker()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := session.Stop(); err != nil {
+		t.Fatal(err)
+	}
+
+	if conn.startRequests != 1 || conn.startResponses != 1 || conn.stopCommands != 1 {
+		t.Fatalf("start/accepted-response/stop = %d/%d/%d, want 1/1/1", conn.startRequests, conn.startResponses, conn.stopCommands)
+	}
+}
+
+func TestSpeakerLifecycleAcceptsCS2WireOrderResponse(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	conn.responseOuter = 0x01100000
+	client := newLifecycleReviewClient(conn)
+	t.Cleanup(func() { _ = client.Close() })
+
+	session, err := client.StartSpeaker()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := session.Stop(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestSpeakerLifecycleRejectsOverlappingStart(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	client := newLifecycleReviewClient(conn)
+	t.Cleanup(func() { _ = client.Close() })
+
+	if _, err := client.StartSpeaker(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := client.StartSpeaker(); err == nil {
+		t.Fatal("overlapping speaker start was accepted")
+	}
+}
+
+func TestSpeakerLifecycleStopsWritesAfterStop(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	client := newLifecycleReviewClient(conn)
+	t.Cleanup(func() { _ = client.Close() })
+
+	session, err := client.StartSpeaker()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := session.Stop(); err != nil {
+		t.Fatal(err)
+	}
+	writesBefore := conn.packetWrites
+	_ = session.WriteAudio(codecPCMA, make([]byte, 320))
+	if conn.packetWrites != writesBefore {
+		t.Fatalf("audio writes after stop = %d, want 0", conn.packetWrites-writesBefore)
+	}
+}
+
+func TestSpeakerLifecycleSurfacesFirstWriteError(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	conn.writePacketErr = errors.New("synthetic channel-3 failure")
+	client := newLifecycleReviewClient(conn)
+	t.Cleanup(func() { _ = client.Close() })
+	producer := &Producer{
+		Connection: core.Connection{Transport: conn},
+		client:     client,
+	}
+	codec := &core.Codec{Name: core.CodecPCMA, ClockRate: 8000}
+	media := &core.Media{Kind: core.KindAudio, Direction: core.DirectionSendonly, Codecs: []*core.Codec{codec}}
+	track := core.NewReceiver(media, codec)
+
+	if err := producer.AddTrack(media, codec, track); err != nil {
+		t.Fatal(err)
+	}
+	producer.Senders[0].Handler(&rtp.Packet{Payload: make([]byte, 320)})
+	if err := producer.SettleBackchannel(); !errors.Is(err, errSpeakerAudioWrite) {
+		t.Fatalf("stop error = %v, want first audio write error", err)
+	}
+	if len(producer.Senders) != 0 {
+		t.Fatalf("residual sender count = %d, want 0", len(producer.Senders))
+	}
+}
+
+func TestSpeakerLifecycleKeepsFirstFailureStage(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	conn.writePacketErr = errors.New("synthetic channel-3 failure")
+	conn.stopCommandErr = errors.New("synthetic stop failure")
+	client := newLifecycleReviewClient(conn)
+	t.Cleanup(func() { _ = client.Close() })
+	session, err := client.StartSpeaker()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := session.WriteAudio(codecPCMA, make([]byte, 320)); !errors.Is(err, errSpeakerAudioWrite) {
+		t.Fatalf("write error = %v, want audio write failure", err)
+	}
+	if err := session.Stop(); !errors.Is(err, errSpeakerAudioWrite) {
+		t.Fatalf("stop error = %v, want first audio write failure", err)
+	}
+	if stage := client.SpeakerLifecycleStatus().LastFailureStage; stage != "audio_write" {
+		t.Fatalf("last failure stage = %q, want first audio_write stage", stage)
+	}
+}
+
+func TestRepeatedSpeakerLifecycleLeavesNoActiveGeneration(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	client := newLifecycleReviewClient(conn)
+	t.Cleanup(func() { _ = client.Close() })
+
+	for i := 0; i < 20; i++ {
+		session, err := client.StartSpeaker()
+		if err != nil {
+			t.Fatalf("cycle %d start: %v", i, err)
+		}
+		if err := session.Stop(); err != nil {
+			t.Fatalf("cycle %d stop: %v", i, err)
+		}
+	}
+	if conn.startRequests != 20 || conn.startResponses != 20 || conn.stopCommands != 20 || conn.pendingResponses != 0 {
+		t.Fatalf("starts/responses/stops/pending = %d/%d/%d/%d, want 20/20/20/0", conn.startRequests, conn.startResponses, conn.stopCommands, conn.pendingResponses)
+	}
+}
+
+func TestSpeakerLifecycleRejectsUnknownCommandResponse(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	conn.responseCommand = 0x7fffffff
+	client := newLifecycleReviewClient(conn)
+	t.Cleanup(func() { _ = client.Close() })
+
+	if _, err := client.StartSpeaker(); !errors.Is(err, errSpeakerCommandResponse) {
+		t.Fatalf("start error = %v, want fixed command-response failure", err)
+	}
+	starts, _, stops, pending, writes := conn.snapshot()
+	if starts != 1 || stops != 1 || pending != 0 || writes != 0 {
+		t.Fatalf("starts/stops/pending/writes = %d/%d/%d/%d, want 1/1/0/0", starts, stops, pending, writes)
+	}
+}
+
+func TestSpeakerLifecycleRejectsDuplicateStartResponse(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	conn.responseCopies = 2
+	client := newLifecycleReviewClient(conn)
+	t.Cleanup(func() { _ = client.Close() })
+
+	session, startErr := client.StartSpeaker()
+	if startErr == nil {
+		if err := waitForCommandFailure(t, client); !errors.Is(err, errSpeakerCommandResponse) {
+			t.Fatalf("command failure = %v", err)
+		}
