+func TestSpeakerLifecycleDiagnosticsAreBoundedAndClosed(t *testing.T) {
+	conn := newLifecycleReviewConn()
+	client := newLifecycleReviewClient(conn)
+	t.Cleanup(func() { _ = client.Close() })
+	producer := &Producer{
+		Connection: core.Connection{Protocol: "synthetic", Transport: conn},
+		client:     client,
+	}
+	codec := &core.Codec{Name: core.CodecPCMA, ClockRate: 8000}
+	media := &core.Media{Kind: core.KindAudio, Direction: core.DirectionSendonly, Codecs: []*core.Codec{codec}}
+	track := core.NewReceiver(media, codec)
+	if err := producer.AddTrack(media, codec, track); err != nil {
+		t.Fatal(err)
+	}
+	if err := producer.SettleBackchannel(); err != nil {
+		t.Fatal(err)
+	}
+
+	payload, err := json.Marshal(producer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var document map[string]any
+	if err := json.Unmarshal(payload, &document); err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]any{
+		"speaker_state":              "closed",
+		"speaker_session_generation": float64(1),
+		"speaker_start_requests":     float64(1),
+		"speaker_start_responses":    float64(1),
+		"speaker_stop_commands":      float64(1),
+		"speaker_write_failures":     float64(0),
+		"speaker_stop_failures":      float64(0),
+		"pending_command_responses":  float64(0),
+		"residual_sender_count":      float64(0),
+		"last_failure_stage":         "none",
+		"producer_generation":        float64(1),
+	}
+	for key, value := range want {
+		if document[key] != value {
+			t.Fatalf("%s = %#v, want %#v", key, document[key], value)
+		}
+	}
+	for _, forbidden := range []string{"command_payload", "response_body", "audio_bytes", "url", "error"} {
+		if _, ok := document[forbidden]; ok {
+			t.Fatalf("forbidden diagnostic field %q", forbidden)
+		}
+	}
+}
