+func (p *Producer) SettleBackchannel() error {
+	p.speakerMu.Lock()
+	defer p.speakerMu.Unlock()
+	if p.speakerSession == nil {
+		return nil
+	}
+	beginErr := p.speakerSession.BeginStop()
+
+	if p.speakerSender != nil {
+		p.speakerSender.Close()
+		p.speakerSender.Wait()
+		for index, sender := range p.Senders {
+			if sender == p.speakerSender {
+				p.Senders = append(p.Senders[:index], p.Senders[index+1:]...)
+				break
+			}
+		}
+	}
+	err := p.speakerSession.Stop()
+	p.speakerSession = nil
+	p.speakerSender = nil
+	if beginErr != nil {
+		return beginErr
+	}
+	return err
+}
