# Copy to runtime/alpha.env and replace every placeholder.
BABY_MONITOR_USERNAME=parent
BABY_MONITOR_PASSWORD=replace-with-a-long-random-password
BABY_MONITOR_STREAM=live
GO2RTC_BASE_URL=http://127.0.0.1:1984

# Android ntfy topic. Use a long unguessable topic name.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=replace-with-private-random-topic
# Optional when using an authenticated ntfy server.
NTFY_TOKEN=
